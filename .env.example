# DeepSeek API credential. Leave empty if you prefer to configure it later in
# the local Web UI and persist it in the dsh-home volume.
DEEPSEEK_API_KEY=

# Directory exposed to the agent as /workspace.
DSH_WORKSPACE=.

# Browser port on the Docker host. compose.yaml binds it to 127.0.0.1 only.
DSH_HOST_PORT=3080

# Published Docker Hub image. Override with deepseek-harness:local when building
# and running the repository locally.
DEEPSEEK_HARNESS_IMAGE=alliot/deepseek-harness:0.1.0-rc.6.2

# Comma-separated host[:port] authorities accepted by the /api browser-trust
# fence. Leave empty for direct localhost access. Set the public hostname when
# using a reverse proxy, for example: dsh.example.com
DSH_TRUSTED_HOSTS=

# Keep the upstream configuration plane loopback-only by default. Set to 1 only
# behind an authenticated HTTPS reverse proxy, together with DSH_TRUSTED_HOSTS.
DSH_ALLOW_REMOTE_CONFIGURATION=0

# Telemetry is opt-in in this image.
DSH_TELEMETRY_DISABLED=1
