# DeepSeek API credential. Leave empty if you prefer to configure it later in
# the local Web UI and persist it in the dsh-home volume.
DEEPSEEK_API_KEY=

# Directory exposed to the agent as /workspace.
DSH_WORKSPACE=.

# Browser port on the Docker host. compose.yaml binds it to 127.0.0.1 only.
DSH_HOST_PORT=3080

# Set to an already-published image to skip the local Compose build result.
DEEPSEEK_HARNESS_IMAGE=deepseek-harness:local

# Telemetry is opt-in in this image.
DSH_TELEMETRY_DISABLED=1
